---
import Base from '../layouts/Base.astro'
import { profile, projects } from '../data/content'
import { to, pageFor } from '../lib/paths'
import MediaView from '../components/Media.astro'

const depth = 0
const featured = projects
const others = projects
const first = projects.map((p) => Number.parseInt(p.year)).filter(Boolean)
const span = `${Math.min(...first)} to now`
---
<Base
  title={`${profile.name}, software engineering student`}
  description={`${profile.role}. Client work, products, tools and games, ${span}.`}
  canonicalPath="/"
  active="work"
  depth={depth}
>
  <!-- Top: name on the left, intro and photo on the right -->
  <section class="wrap top">
    <h1>{profile.name}</h1>
    <div class="aside">
      <div class="intro">
        <p>{profile.intro}</p>
        <p class="meta"><a class="textlink" href={to(depth, pageFor.about)}>About me and the timeline</a></p>
      </div>
      <figure class="photo">
        {profile.photo.src
          ? <img src={to(depth, profile.photo.src)} alt={profile.photo.alt} />
          : <div class="placeholder"><span><b>Image needed</b>{profile.photo.needed}</span></div>}
      </figure>
    </div>
  </section>

  <!-- Stage: the current project big and tilted, previous and next smaller on each side -->
  <section class="stage-wrap" aria-roledescription="carousel" aria-label="Selected work">
    <div class="stage" tabindex="0" aria-label="Use the left and right arrow keys to change project">
      {featured.map((p, i) => (
        <a
          class="slide"
          href={to(depth, pageFor.project(p.slug))}
          data-i={i}
          aria-label={`${p.title}: ${p.kind}`}
        >
          <div class="card">
            <div class="panel">
              {p.cover.src || p.cover.illustration
                ? <MediaView m={{ ...p.cover, alt: '' }} depth={depth} eager={i < 2} />
                : <span class="noimg">{p.title}</span>}
            </div>
            <span class="shade" aria-hidden="true"><span class="lbl"></span></span>
          </div>
        </a>
      ))}
    </div>

    <div class="wrap caption">
      <button type="button" class="nav prev" aria-label="Previous project">Prev</button>
      <div class="now" aria-live="polite">
        {featured.map((p, i) => (
          <div class="item" data-i={i} hidden={i !== 0}>
            <a class="t" href={to(depth, pageFor.project(p.slug))}>{p.title}</a>
            <span class="k">{p.kind}</span>
          </div>
        ))}
        <span class="count"><span class="cur">1</span> / {featured.length}</span>
      </div>
      <button type="button" class="nav next" aria-label="Next project">Next</button>
    </div>
  </section>

  <!-- Every project as a list, same order as the carousel -->
  <section class="wrap list" aria-labelledby="main-h">
    <h2 id="main-h" class="list-h">All projects</h2>
    <ol class="index small">
      {others.map((p) => (
        <li><a class="row" href={to(depth, pageFor.project(p.slug))}><span class="t">{p.title}<sup>{p.year}</sup></span><span class="k">{p.kind}</span></a></li>
      ))}
    </ol>
  </section>
</Base>

<style>
  /* ---------- top ---------- */
  .top { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px clamp(32px, 5vw, 72px); padding-block: clamp(32px, 6vw, 72px) clamp(24px, 4vw, 48px); align-items: start }
  h1 { font: 800 clamp(2.8rem, 7.4vw, 6.6rem)/1.04 var(--display); letter-spacing: -0.045em; max-width: 9ch }
  .aside { display: grid; grid-template-columns: minmax(0, 1fr) clamp(130px, 14vw, 200px); gap: clamp(20px, 3vw, 36px); align-items: start }
  .intro { display: grid; gap: 14px; font-size: 1.05rem; line-height: 1.55; color: var(--ink-2); padding-top: 6px }
  .meta { font-size: 15px }
  .photo { margin: 0 }
  .photo img, .photo .placeholder { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 6px }
  .photo .placeholder { font-size: 12px; padding: 10px }

  /* ---------- stage ---------- */
  .stage-wrap { margin-top: clamp(8px, 2vw, 24px) }
  .stage {
    position: relative; height: clamp(300px, 38vw, 560px); perspective: 1600px; perspective-origin: 50% 20%;
    overflow: hidden; outline: none; touch-action: pan-y; user-select: none;
  }
  .stage:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px }
  .slide {
    position: absolute; left: 50%; top: 6%; width: min(46vw, 720px); aspect-ratio: 16 / 10;
    transform-style: preserve-3d; text-decoration: none; color: inherit;
    transition: transform .7s cubic-bezier(.2, .7, .2, 1), opacity .5s;
    transform: translateX(-50%) scale(.35); opacity: 0; pointer-events: none;
  }
  .slide[data-pos='0'] { transform: translateX(-50%); opacity: 1; pointer-events: auto; z-index: 3 }
  .slide[data-pos='-1'] { transform: translateX(calc(-50% - min(35vw, 548px))) translateY(30%) rotateY(18deg) scale(.42); opacity: 1; pointer-events: auto; z-index: 2 }
  .slide[data-pos='1'] { transform: translateX(calc(-50% + min(35vw, 548px))) translateY(30%) rotateY(-18deg) scale(.42); opacity: 1; pointer-events: auto; z-index: 2 }
  .slide[data-pos='-2'] { transform: translateX(calc(-50% - 70vw)) translateY(30%) scale(.3) }
  .slide[data-pos='2'] { transform: translateX(calc(-50% + 70vw)) translateY(30%) scale(.3) }

  .card {
    position: relative; width: 100%; height: 100%; border-radius: 14px; overflow: hidden;
    transform: rotateX(var(--rx, 14deg)) rotateY(var(--ry, 0deg)); transform-origin: 50% 100%;
    transition: transform .25s ease-out, box-shadow .25s;
    box-shadow: 0 40px 70px -30px rgb(23 22 20 / .45);
  }
  .slide:not([data-pos='0']) .card { --rx: 8deg; --ry: 0deg; box-shadow: 0 24px 40px -24px rgb(23 22 20 / .35) }
  .panel { width: 100%; height: 100%; background: var(--paper-2); display: flex }
  .panel :global(img), .panel :global(.ill) { width: 100%; height: 100%; object-fit: cover; object-position: top }
  .noimg { margin: auto; font: 800 clamp(1.6rem, 4vw, 3.4rem)/1 var(--display); letter-spacing: -0.03em; color: var(--ink); text-align: center }

  .shade { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(108 103 94 / .62); opacity: 0; transition: opacity .4s }
  .slide:not([data-pos='0']) .shade { opacity: 1 }
  .slide:not([data-pos='0']):hover .shade { background: rgb(108 103 94 / .48) }
  .lbl { font: 800 clamp(1.6rem, 5vw, 4.4rem)/1 var(--display); letter-spacing: 0.06em; color: #f6f5f1 }
  .slide[data-pos='-1'] .lbl::before { content: 'PREV' }
  .slide[data-pos='1'] .lbl::before { content: 'NEXT' }

  .caption { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; margin-top: 8px }
  .now { display: flex; align-items: baseline; gap: 6px 20px; flex-wrap: wrap; min-width: 0 }
  .now .item { display: contents }
  .now .item[hidden] { display: none }
  .now .t { font: 800 clamp(1.4rem, 2.6vw, 2.1rem)/1.1 var(--display); letter-spacing: -0.03em; text-decoration: none }
  .now .t:hover { color: var(--accent) }
  .now .k { color: var(--ink-2); font-size: 15px }
  .count { margin-left: auto; font: 400 13px var(--mono); color: var(--dim); font-variant-numeric: tabular-nums }
  .nav { font: 600 13px var(--body); letter-spacing: 0.06em; text-transform: uppercase; background: transparent; color: var(--ink); border: 1px solid var(--ink); border-radius: 999px; padding: 0 16px; min-height: 44px; cursor: pointer }
  .nav:hover { background: var(--ink); color: var(--paper) }

  /* ---------- lists ---------- */
  .list { margin-top: clamp(56px, 8vw, 104px) }
  .list-h { font: 400 13px var(--body); color: var(--dim); padding-bottom: 8px; border-bottom: 1px solid var(--ink) }
  .list-h.small { margin-top: clamp(48px, 6vw, 72px) }
  .index { list-style: none; margin: 0; padding: 0 }
  .index li { border-bottom: 1px solid var(--rule) }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 22rem); gap: 20px; align-items: baseline; text-decoration: none; padding-block: 8px 10px }
  .row .t { font: 800 clamp(1.7rem, 4.2vw, 3.4rem)/1.04 var(--display); letter-spacing: -0.035em; min-width: 0; transition: color .15s }
  .row .k { font-size: 15px; color: var(--ink-2) }
  .row:hover .t, .row:focus-visible .t { color: var(--accent) }
  .index.small .row .t { font-size: clamp(1.2rem, 2vw, 1.5rem); letter-spacing: -0.02em }
  .index.small sup { font: 400 12px/0 var(--mono); letter-spacing: 0; color: var(--dim); margin-left: 8px }

  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr }
    .aside { grid-template-columns: minmax(0, 1fr) 110px }
    .slide { width: 66vw }
    .slide[data-pos='-1'] { transform: translateX(calc(-50% - 44vw)) translateY(24%) rotateY(18deg) scale(.5) }
    .slide[data-pos='1'] { transform: translateX(calc(-50% + 44vw)) translateY(24%) rotateY(-18deg) scale(.5) }
    .stage { height: clamp(240px, 58vw, 400px) }
    .caption { grid-template-columns: 1fr 1fr }
    .now { grid-column: 1 / -1; grid-row: 1 }
    .nav.prev { justify-self: start }
    .nav.next { justify-self: end }
    .row { grid-template-columns: 1fr; gap: 2px }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { --rx: 0deg !important; --ry: 0deg !important }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.stage')
  const slides = [...document.querySelectorAll<HTMLAnchorElement>('.stage .slide')]
  const items = [...document.querySelectorAll<HTMLElement>('.now .item')]
  const cur = document.querySelector<HTMLElement>('.now .cur')
  const n = slides.length
  let index = 0

  // Shortest signed distance from the current slide, so the carousel wraps around.
  const offset = (i: number) => {
    let d = i - index
    if (d > n / 2) d -= n
    if (d < -n / 2) d += n
    return d
  }

  function render() {
    slides.forEach((s, i) => {
      const d = offset(i)
      s.dataset.pos = String(Math.max(-2, Math.min(2, d)))
      s.tabIndex = d === 0 ? 0 : -1
      const card = s.querySelector<HTMLElement>('.card')!
      card.style.removeProperty('--rx'); card.style.removeProperty('--ry')
    })
    items.forEach((it, i) => (it.hidden = i !== index))
    if (cur) cur.textContent = String(index + 1)
  }
  const go = (step: number) => { index = (index + step + n) % n; render() }

  // Side slides move the carousel; only the middle one opens the project page.
  slides.forEach((s, i) => s.addEventListener('click', (e) => {
    const d = offset(i)
    if (d !== 0) { e.preventDefault(); go(d) }
  }))
  document.querySelector('.nav.prev')?.addEventListener('click', () => go(-1))
  document.querySelector('.nav.next')?.addEventListener('click', () => go(1))
  stage?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1) }
    if (e.key === 'ArrowRight') { e.preventDefault(); go(1) }
  })

  // Swipe on touch screens.
  let startX: number | null = null
  stage?.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') startX = e.clientX })
  stage?.addEventListener('pointerup', (e) => {
    if (startX === null) return
    const dx = e.clientX - startX; startX = null
    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1)
  })

  // The middle card leans towards the mouse. It starts tilted back and straightens up under the pointer.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches
  if (!reduce && fine) {
    slides.forEach((s) => {
      const card = s.querySelector<HTMLElement>('.card')!
      s.addEventListener('pointermove', (e) => {
        if (s.dataset.pos !== '0') return
        const r = s.getBoundingClientRect()
        const x = (e.clientX - r.left) / r.width - 0.5
        const y = (e.clientY - r.top) / r.height - 0.5
        card.style.setProperty('--rx', `${(4 + y * 10).toFixed(2)}deg`)
        card.style.setProperty('--ry', `${(x * 12).toFixed(2)}deg`)
      })
      s.addEventListener('pointerleave', () => { card.style.removeProperty('--rx'); card.style.removeProperty('--ry') })
    })
  }

  render()
</script>
